{
  "name": "Grok-Desktop",
  "version": "1.3.0",
  "description": "Grok-Desktop application for Grok.com with tab support",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "pack": "electron-builder --dir --publish never",
    "build-portable": "electron-builder --win portable --publish never",
    "build-dir": "electron-builder --dir --publish never",
    "build-installer": "electron-builder --win --x64 --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "build-rpm": "electron-builder --linux rpm --publish never",
    "build-deb": "electron-builder --linux deb --publish never",
    "build-rpm-deb": "electron-builder --linux rpm deb --publish never",
    "build-all": "electron-builder --win --x64 --linux --publish never",
    "test": "node --test test/*.test.js",
    "test:electron": "node test/electron-smoke.cjs"
  },
  "keywords": [
    "electron",
    "grok",
    "desktop",
    "tabs"
  ],
  "author": "AnRkey <anrkey@gmail.com>",
  "license": "GPL-2.0-only",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.grok.desktop",
    "productName": "Grok Desktop",
    "directories": {
      "output": "build"
    },
    "linux": {
      "target": [
        "rpm",
        "deb"
      ],
      "category": "Network",
      "icon": "build-resources/icons"
    },
    "rpm": {
      "artifactName": "Grok-Desktop-v${version}.${ext}"
    },
    "deb": {
      "artifactName": "Grok-Desktop-v${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ],
      "icon": "src/grok.png",
      "forceCodeSigning": false,
      "artifactName": "Grok-Desktop_Archive-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grok Desktop",
      "artifactName": "Grok-Desktop_Installer-v${version}.exe"
    },
    "msi": {
      "artifactName": "Grok-Desktop_Installer-v${version}.msi"
    },
    "portable": {
      "artifactName": "Grok-Desktop_Portable-v${version}.exe"
    },
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [],
    "extraResources": [],
    "files": [
      "src/**/*",
      "index.html",
      "about.html",
      "styles.css",
      "assets/**/*",
      "LICENSE",
      "LICENSE_Electron",
      "package.json"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "@electron/asar": {
      ".": "4.3.1",
      "glob": "14.0.3"
    },
    "@electron/universal": "3.0.6"
  }
}
